{
  "name": "nav-v2",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "bin": {
    "nav": "tools/cli/nav.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && vercel deploy --prod --yes --name=navigator-v2",
    "publish": "node scripts/publish.mjs",
    "watch:deploy": "node scripts/watch-deploy.mjs",
    "validate": "node scripts/validate-data.mjs",
    "auth:hash": "node scripts/hash-password.mjs",
    "check": "node scripts/check-sites.mjs",
    "check:report": "node scripts/check-sites.mjs --only-bad --report",
    "icons": "node scripts/fetch-favicons.mjs",
    "perf": "node scripts/perf-scroll.mjs",
    "console": "node tools/console/server.mjs",
    "console:strict": "node tools/console/server.mjs --port 5175 --strict-port",
    "console:test": "node tools/console/test-trust.mjs",
    "console:test:infer": "node tools/console/test-infer.mjs",
    "console:test:guard": "node tools/console/test-guard.mjs",
    "console:test:hunks": "node tools/console/test-hunks.mjs",
    "console:test:ops": "node tools/console/test-ops.mjs",
    "console:test:purposes": "node tools/console/test-purposes.mjs",
    "console:test:visual": "node tools/console/test-visual-scheme.mjs",
    "console:test:url": "node tools/console/test-url.mjs",
    "console:test:auto-add": "node tools/console/test-auto-add.mjs",
    "console:test:auto-category": "node tools/console/test-auto-category.mjs",
    "console:test:api": "node --experimental-test-module-mocks tools/console/test-api-ops.mjs",
    "console:test:netguard": "node tools/console/test-netguard.mjs",
    "console:test:session": "node --experimental-test-module-mocks tools/console/test-session.mjs",
    "console:test:sites": "node --experimental-test-module-mocks tools/console/test-sites-cas.mjs",
    "console:test:robust": "node tools/console/test-robust.mjs",
    "console:test:frontend": "node tools/console/test-frontend.mjs",
    "console:test:bundle": "node tools/console/test-bundle.mjs",
    "console:test:all": "node tools/console/test-trust.mjs && node tools/console/test-infer.mjs && node tools/console/test-purposes.mjs && node tools/console/test-visual-scheme.mjs && node tools/console/test-url.mjs && node tools/console/test-auto-add.mjs && node tools/console/test-auto-category.mjs && node tools/console/test-guard.mjs && node tools/console/test-hunks.mjs && node tools/console/test-ops.mjs && node --experimental-test-module-mocks tools/console/test-api-ops.mjs && node tools/console/test-netguard.mjs && node tools/console/test-robust.mjs && node tools/console/test-frontend.mjs && node --experimental-test-module-mocks tools/console/test-session.mjs && node --experimental-test-module-mocks tools/console/test-sites-cas.mjs && node tools/console/test-bundle.mjs",
    "console:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/install-autostart.ps1",
    "console:autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/install-autostart.ps1 -Uninstall",
    "console:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/start.ps1",
    "console:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/stop.ps1",
    "console:shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/sync-shortcuts.ps1",
    "console:icon": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/build-icon.ps1",
    "console:service": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/install-service.ps1",
    "console:service:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/console/launcher/install-service.ps1 -Uninstall",
    "nav": "node tools/cli/nav.mjs",
    "mcp": "node tools/mcp/server.mjs",
    "mcp:test": "node tools/mcp/test-mcp.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "fuse.js": "^7.5.0",
    "pinia": "^2.1.0",
    "pinia-plugin-persistedstate": "^3.2.0",
    "pinyin-pro": "^3.28.2",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
