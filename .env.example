# 复制为 .env.local 并按需填写 / 配置到 Vercel Production 环境

# 站点数据发布管理密钥（必填，用于 api/sites 的 POST 鉴权；也是 CLI / 脚本的凭据）
# 在 Vercel 项目 Production 中配置同名变量
SITES_ADMIN_KEY=""

# 管理后台登录（可选，配齐后可在 /admin 用「用户名 + 口令」登录，无需手输密钥）
# 口令哈希用 `npm run auth:hash -- "你的口令"` 生成；切勿把明文口令写进任何文件
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# 会话 token 的 HMAC 签名密钥（可选；缺省回退到 SITES_ADMIN_KEY）
# 建议单独设一个随机长串，这样轮换管理密钥不会让所有登录态失效
AUTH_SECRET=""

# Vercel Blob（站点数据云端存储）
BLOB_READ_WRITE_TOKEN=""
BLOB_WEBHOOK_PUBLIC_KEY=""
BLOB_STORE_ID=""

# Vercel 全局配置
GLOBAL_CONFIG=""