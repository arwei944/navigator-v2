# 本文件由 shared/env-registry.mjs 生成 —— 请勿手工编辑。
# 重新生成：npm run env:example
# 用法：复制为 .env.local 并按需填写。

# ── 管理后台 / 鉴权 ──
# 站点数据发布管理密钥；api/sites 的 POST 鉴权，也是 CLI / 脚本的共享凭据（主链路必需）
SITES_ADMIN_KEY=""

# 过渡期保留的上一把共享密钥，与 SITES_ADMIN_KEY 同时有效。用于轮换时不让旧客户端被锁在外面；确认切换完成后应删除（可选）
SITES_ADMIN_KEY_PREVIOUS=""

# 后台登录口令的 scrypt 哈希；配齐后可在 /admin 用口令登录，未配则回 500（密钥直连照常可用）（可选）
ADMIN_PASSWORD_HASH=""

# 会话 token 的 HMAC 签名密钥；缺省回退到 SITES_ADMIN_KEY（单独设置后轮换密钥不会让登录态失效）（可选）
AUTH_SECRET=""

# ── 部署 / 发布 ──
# BotKeep 部署 API 凭据（release run / deploy-botkeep）（主链路必需）
BOTKEEP_API_KEY=""

# BotKeep workload 标识；与 .deploy-manifest.json 比对可判断是否换端点（主链路必需）
BOTKEEP_WORKLOAD_ID=""

# 发布后的站点地址；供线上验证与状态查询使用（发布通道也可提供，优先于本项）（可选）
DEPLOY_SITE_URL="https://your-site.example"

# ── 运行时 / 服务端 ──
# 告警站外出口（G3）：巡检判出连续不可达时 POST 到此地址；逗号分隔即多渠道；留空则完全不推送（可选）
NAV_ALERT_WEBHOOK_URL=""
