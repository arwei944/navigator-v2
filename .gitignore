node_modules
dist
.DS_Store
*.local
.vercel
.env
.env.*
!.env.example
backups/
tmp-payload.json
tmp-console-payload.json
perf-report/
tools/console/launcher/nssm/
tools/console/launcher/logs/
tools/console/launcher/icon-*.png
# 控制台运行时数据：审计日志、探活快照、发布历史，属本机状态，不入库
tools/console/.data/
tools/console/.deploy-history.json
tools/console/.deploy-checkpoint.json
tools/console/.deploy-manifest.json
# 探针产物：报告 / 运行日志 / 截图由脚本生成，只作本机验收证据，不入库
_probe-report*.json
_chrome-report.json
probe/_*.json
probe/_*.txt
probe/*.png
# 线上验收脚本的中间产物目录（响应体 / 响应头 / 构造出来的大体积请求体）
probe/_*/
# 零依赖 CDP 验证用的临时 Chrome 配置目录（每次测量都该是干净的）
.chrome-*/
# WorkBuddy「发布应用」在本机写的应用追踪标记（对应哪个分享链接，属本机状态）
.wbapp_*.genie

# 项目级 agent 工作区（设计草稿 / 工作日志等本机状态）
.workbuddy/
# SQLite 数据目录（本机 console 调试用，线上在沙箱 data/，均不入库）
server/data/
# 仓库根的 data/：管理凭据回填文件（admin-key.txt / admin-password-hash.txt 等）。
# **绝不能入库** —— 哈希虽然反推不出口令，但它是口令的离线爆破目标。
/data/

# 一次性代理探测产物（本机状态，不入库）
tools/proxy-ports.txt

# 本机控制台的插件配置（引擎链选择，属本机状态，不改线上）
plugins.local.json

# 图标抓取脚本（scripts/fetch-favicons.mjs）写回 api/sites-data.json 前的备份副产物
# 每次运行都生成一份带时间戳的 .bak-*.json，属本机状态，不入库
api/sites-data.bak-*.json
api/*.bak-*.json
